  "license": "MIT",
  "homepage": "https://iconavo.dev/docs",
  "bugs": {
    "url": "https://github.com/iconavo/iconavo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconavo/iconavo.git",
    "directory": "packages/icon"
  },
