{
  "name": "@iconavo-ui/core",
  "version": "0.1.1",
  "description": "The shared core of the Iconavo icon packages: loading, the icon store and rendering. Install @iconavo-ui/icon or @iconavo-ui/react instead.",
  "keywords": [
    "iconavo",
    "icons",
    "svg",
    "iconify"
  ],
  "license": "MIT",
  "homepage": "https://iconavo.dev/docs",
  "bugs": {
    "url": "https://github.com/iconavo/iconavo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconavo/iconavo.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
