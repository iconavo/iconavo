{
  "name": "iconavo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.19.0 || ^24.5.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run",
    "size": "size-limit",
    "sources": "tsc -b && node packages/pipeline/dist/cli.js",
    "validate": "tsc -b && node packages/schema/dist/cli.js",
    "sanitize": "tsc -b && node packages/pipeline/dist/cli.js sanitize",
    "normalize": "tsc -b && node packages/pipeline/dist/cli.js normalize",
    "data": "tsc -b && node packages/pipeline/dist/cli.js data",
    "pr": "tsc -b && node packages/pipeline/dist/cli.js pr",
    "enrich": "tsc -b && node --env-file-if-exists=.env packages/pipeline/dist/cli.js enrich",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm size"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@size-limit/preset-small-lib": "^14.2.0",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
