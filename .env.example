# Скопируйте этот файл в .env и впишите значения через редактор.
# Файл .env в git не попадает. Ключи не вставляйте в чат и не коммитьте.

# Claude Platform: обогащение иконок (описания, синонимы)
ANTHROPIC_API_KEY=

# Polza AI (агрегатор): временно вместо ключей OpenAI и Google для эмбеддингов
POLZA_API_KEY=

# Cloudflare R2: выгрузка раздачи pnpm cdn upload (ADR-0022). Токен «Object Read & Write» только на
# бакет iconavo-cdn; идентификатор аккаунта — 32 символа из адреса S3 {id}.r2.cloudflarestorage.com.
# В CI те же имена — секреты GitHub Actions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
