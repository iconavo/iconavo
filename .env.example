# Скопируйте этот файл в .env и впишите значения через редактор.
# Файл .env в git не попадает. Ключи не вставляйте в чат и не коммитьте.

# Claude Platform: обогащение иконок (описания, синонимы)
ANTHROPIC_API_KEY=

# Polza AI (агрегатор): временно вместо ключей OpenAI и Google для эмбеддингов
POLZA_API_KEY=

# Cloudflare R2: выгрузка раздачи pnpm cdn upload и сверка pnpm cdn verify (ADR-0022). Токен
# «Object Read & Write» только на бакет iconavo-cdn; идентификатор аккаунта — 32 символа из адреса S3
# {id}.r2.cloudflarestorage.com. В CI те же имена — секреты GitHub Actions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bunny: второй хост раздачи cdn2.iconavo.dev (ADR-0025). Пароль хранилища iconavo-cdn — Storage →
# FTP & API Access → Password (не Read-only). Локально нужен, только если запускать upload --dry-run
# или verify с компьютера; выгружает CI, там это секрет GitHub Actions с тем же именем.
BUNNY_STORAGE_PASSWORD=

# npm: локального ключа нет — пакеты публикует только CI доверенной публикацией (ADR-0026). Временный
# токен первой публикации нового пакета — секрет NPM_TOKEN окружения npm в GitHub, не здесь.

# Cloudflare Workers: локального ключа нет — функцию edge API выкладывает только CI (ADR-0024). Ключ
# CLOUDFLARE_API_TOKEN (Account · Workers Scripts · Edit) — секрет окружения api в GitHub, не здесь.
